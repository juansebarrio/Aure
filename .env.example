# === AURE — variables de entorno (EJEMPLO) ===
# Copiá este archivo a `.env.local` y completá los valores.
# `.env` y `.env*.local` están en .gitignore: NUNCA comitear secretos.

# --- Público (expuesto al browser, prefijo NEXT_PUBLIC_) ---

# WhatsApp: número en formato internacional, solo dígitos (sin "+", sin espacios).
# Si no se setea, usa el número real de AURE por defecto (ver lib/site.ts).
# Ej. AR móvil: 5491130500088
NEXT_PUBLIC_WHATSAPP=

# URL canónica del sitio (para metadata, Open Graph, sitemap).
# En producción va el dominio final (https://www.aure.ar al migrar). Mientras
# el sitio viva en Vercel, setear la URL del deploy (https://aure-ebon.vercel.app)
# para que el Open Graph resuelva bien. Sin setear, el fallback es www.aure.ar.
NEXT_PUBLIC_SITE_URL=

# --- Propiedades (Tokko Broker) ---

# API key de Tokko Broker (SERVER-SIDE, sin prefijo NEXT_PUBLIC, nunca en el
# cliente ni commiteada).
#  - Sin setear: el sitio usa el MOCK (lib/properties.mock.ts) y el formulario
#    NO postea al CRM (responde ok igual).
#  - Al setearla: las propiedades salen del feed REAL de Tokko y las consultas
#    del formulario entran al CRM (webcontact).
# Puesta en vivo + verificación del mapeo: ver TOKKO_INTEGRATION.md.
TOKKO_API_KEY=

# --- Integraciones futuras (STUB por ahora — no configurar todavía) ---

# Resend — mail interno + confirmación del formulario (TODO: conectar en /api/contacto)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=contacto@aure.example
# CONTACT_FROM_EMAIL=no-reply@aure.example

# Instagram — feed real (TODO: reemplazar el mock de <InstagramFeed>)
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=

# Medición — GA4 / Meta Pixel (TODO: faltan claves y definición del cliente; NO instalar aún)
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
